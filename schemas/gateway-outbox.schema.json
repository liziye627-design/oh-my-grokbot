{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "tenantId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "origin": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "manual",
            "feishu"
          ]
        },
        "chatId": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "chatId",
        "messageId"
      ],
      "additionalProperties": false
    },
    "text": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "sending",
        "sent",
        "needs_human"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "receipt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "tenantId",
    "taskId",
    "origin",
    "text",
    "state",
    "attempts",
    "receipt"
  ],
  "additionalProperties": false
}
