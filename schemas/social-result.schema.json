{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "x",
        "bluesky",
        "mastodon",
        "youtube"
      ]
    },
    "query": {
      "type": "string"
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "requests": {
      "type": "number",
      "const": 1
    },
    "truncated": {
      "type": "boolean"
    },
    "items": {
      "readOnly": true,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "contentFormat": {
            "type": "string",
            "enum": [
              "text",
              "html"
            ]
          },
          "publishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "url",
          "author",
          "text",
          "contentFormat",
          "publishedAt"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "platform",
    "query",
    "retrievedAt",
    "requests",
    "truncated",
    "items",
    "warnings"
  ],
  "additionalProperties": false
}
