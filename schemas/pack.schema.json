{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "ohmy.dev/v0alpha1"
    },
    "kind": {
      "type": "string",
      "const": "IndustryPack"
    },
    "metadata": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string"
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "enum": [
            "discovered",
            "reviewed",
            "compatible",
            "verified"
          ]
        }
      },
      "required": [
        "name",
        "version",
        "maintainer",
        "license",
        "description",
        "verification"
      ],
      "additionalProperties": false
    },
    "spec": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "providers": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "grokbot",
              "muse"
            ]
          }
        },
        "requirements": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "capability": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "range": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              },
              "fit": {
                "type": "string",
                "enum": [
                  "text",
                  "image",
                  "audio",
                  "code"
                ]
              }
            },
            "required": [
              "capability",
              "range",
              "optional"
            ],
            "additionalProperties": false
          }
        },
        "agents": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "mission": {
                "type": "string",
                "minLength": 1
              },
              "skills": {
                "readOnly": true,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "expectedOutputs": {
                "readOnly": true,
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "mission",
              "skills",
              "expectedOutputs"
            ],
            "additionalProperties": false
          }
        },
        "policies": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "required": [
        "providers",
        "requirements",
        "agents",
        "policies"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
