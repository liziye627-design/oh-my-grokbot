{
  "pack": {
    "apiVersion": "ohmy.dev/v0alpha1",
    "kind": "IndustryPack",
    "metadata": {
      "name": "oh-my-sales-team",
      "version": "0.1.0",
      "maintainer": "Oh My Grok Bot project",
      "license": "MIT",
      "description": "销售准备团队：寻找公开线索、核查公司、形成方案草稿，并在用户批准前停止外联。",
      "verification": "reviewed"
    },
    "spec": {
      "providers": ["grokbot"],
      "requirements": [
        {
          "capability": "source-research",
          "range": "^0.2.0",
          "optional": false
        },
        {
          "capability": "task-planning",
          "range": "^0.2.0",
          "optional": false
        },
        {
          "capability": "fact-verification",
          "range": "^0.2.0",
          "optional": false
        },
        {
          "capability": "artifact-validation",
          "range": "^0.2.0",
          "optional": false
        },
        {
          "capability": "capability-selection",
          "range": "^0.2.0",
          "optional": false
        },
        {
          "capability": "agent-handoff",
          "range": "^0.2.0",
          "optional": false
        },
        {
          "capability": "approval-protocol",
          "range": "^0.2.0",
          "optional": false
        },
        {
          "capability": "routine-design",
          "range": "^0.2.0",
          "optional": false
        },
        {
          "capability": "native-agent-team",
          "range": "^0.1.0",
          "optional": false
        },
        {
          "capability": "browser-use",
          "range": "^0.1.0",
          "optional": true
        },
        {
          "capability": "composio",
          "range": "^0.1.0",
          "optional": true
        }
      ],
      "agents": [
        {
          "id": "lead-hunter",
          "mission": "按理想客户条件整理公开线索，并写明每条线索的出处和不确定项。",
          "skills": ["source-research", "task-planning"],
          "expectedOutputs": ["lead-list.md"]
        },
        {
          "id": "company-researcher",
          "mission": "核对线索对应的公司事实、产品线索和可验证的业务背景。",
          "skills": ["source-research", "fact-verification"],
          "expectedOutputs": ["company-brief.md"]
        },
        {
          "id": "sales-engineer",
          "mission": "对照方案边界判断线索是否匹配，并指出需要人工确认的风险。",
          "skills": ["fact-verification", "artifact-validation", "capability-selection"],
          "expectedOutputs": ["qualification.md"]
        },
        {
          "id": "proposal-writer",
          "mission": "依据已通过的资格判断起草方案，所有承诺都可回溯到确认过的约束。",
          "skills": ["task-planning", "agent-handoff", "approval-protocol"],
          "expectedOutputs": ["proposal.md"]
        },
        {
          "id": "crm-manager",
          "mission": "把线索状态、下一步负责人和待批准动作整理成可核对的交接，不写入外部系统。",
          "skills": ["agent-handoff", "approval-protocol", "routine-design"],
          "expectedOutputs": ["crm-record.md", "handoff.md"]
        }
      ],
      "policies": ["no-unsolicited-messaging", "explicit-outreach-approval", "no-payment-execution"]
    }
  },
  "workflows": [
    {
      "id": "qualify-lead",
      "name": "线索发现与资格判断",
      "entryRole": "lead-hunter",
      "requiredInputs": ["idealCustomer", "territory", "researchWindow"],
      "approvalRequired": false,
      "steps": [
        {
          "id": "discover",
          "role": "lead-hunter",
          "dependsOn": [],
          "requiredArtifacts": ["lead-list.md"],
          "acceptanceCriteria": ["每条线索有来源", "没有外联动作"]
        },
        {
          "id": "profile",
          "role": "company-researcher",
          "dependsOn": ["discover"],
          "requiredArtifacts": ["company-brief.md"],
          "acceptanceCriteria": ["事实和推断分开", "空白字段保持空白"]
        },
        {
          "id": "score",
          "role": "sales-engineer",
          "dependsOn": ["profile"],
          "requiredArtifacts": ["qualification.md"],
          "acceptanceCriteria": ["结论引用简报证据", "信息不足标为暂缓"]
        },
        {
          "id": "record",
          "role": "crm-manager",
          "dependsOn": ["score"],
          "requiredArtifacts": ["crm-record.md"],
          "acceptanceCriteria": ["状态不是已联系", "下一步负责人明确"]
        }
      ]
    },
    {
      "id": "write-proposal",
      "name": "方案草稿与批准交接",
      "entryRole": "proposal-writer",
      "requiredInputs": ["qualification", "offerConstraints", "recipient"],
      "approvalRequired": true,
      "steps": [
        {
          "id": "draft",
          "role": "proposal-writer",
          "dependsOn": [],
          "requiredArtifacts": ["proposal.md"],
          "acceptanceCriteria": ["承诺都在给定约束内", "草稿未发送"]
        },
        {
          "id": "check",
          "role": "sales-engineer",
          "dependsOn": ["draft"],
          "requiredArtifacts": ["qualification.md"],
          "acceptanceCriteria": ["方案与资格判断一致", "新承诺被标出"]
        },
        {
          "id": "handoff",
          "role": "crm-manager",
          "dependsOn": ["check"],
          "requiredArtifacts": ["handoff.md"],
          "acceptanceCriteria": ["批准绑定收件人和正文", "没有批准就不外发"]
        }
      ]
    }
  ]
}
