{
  "schemaVersion": "0.1",
  "host": "127.0.0.1",
  "port": 19741,
  "principals": [
    {
      "id": "growth-owner",
      "tenantId": "growth",
      "role": "operator",
      "tokenEnv": "GROWTH_OWNER_TOKEN"
    },
    {
      "id": "growth-colleague",
      "tenantId": "growth",
      "role": "operator",
      "tokenEnv": "GROWTH_COLLEAGUE_TOKEN"
    },
    {
      "id": "growth-reviewer",
      "tenantId": "growth",
      "role": "verifier",
      "tokenEnv": "GROWTH_REVIEWER_TOKEN"
    },
    {
      "id": "growth-feishu",
      "tenantId": "growth",
      "role": "channel",
      "tokenEnv": "GROWTH_CHANNEL_TOKEN",
      "chats": ["REPLACE_FEISHU_CHAT_ID"],
      "senders": ["REPLACE_FEISHU_USER_ID"]
    }
  ],
  "workspaces": [
    {
      "id": "growth",
      "name": "增长工作组",
      "tenantId": "growth",
      "pack": "oh-my-x-growth",
      "workflows": [
        "topic-research",
        "content-calendar",
        "export-analytics",
        "write-thread",
        "write-article"
      ],
      "coordinatorRole": "scout",
      "bindings": [
        {
          "role": "scout",
          "botName": "growth/scout"
        },
        {
          "role": "researcher",
          "botName": "growth/researcher"
        },
        {
          "role": "editor",
          "botName": "growth/editor"
        },
        {
          "role": "reviewer",
          "botName": "growth/reviewer"
        },
        {
          "role": "operations",
          "botName": "growth/operations"
        }
      ],
      "members": {
        "operators": ["growth-owner", "growth-colleague"],
        "verifiers": ["growth-reviewer"]
      },
      "feishu": {
        "principalId": "growth-feishu",
        "chatId": "REPLACE_FEISHU_CHAT_ID",
        "senders": [
          {
            "senderId": "REPLACE_FEISHU_USER_ID",
            "principalId": "growth-owner"
          }
        ]
      }
    }
  ],
  "feishu": {
    "principalId": "growth-feishu",
    "appIdEnv": "FEISHU_APP_ID",
    "appSecretEnv": "FEISHU_APP_SECRET"
  }
